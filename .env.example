# Absolute or relative ESM module that exports createCdpChatDriver().
CDP_CHAT_DRIVER_MODULE=./examples/mock-driver.mjs

# Optional: private destination for attachments exported from the disposable fixture.
CDP_CHAT_MEDIA_ROOT=./cdp-chat-media

# Built-in BrowserClaw adapter. It reuses one accessible ChatGPT tab, or opens
# exactly one https://chatgpt.com/ tab when none is accessible. Uncomment this
# section instead of CDP_CHAT_DRIVER_MODULE to use it.
# CDP_CHAT_DRIVER=browserclaw
# CDP_CHAT_BROWSERCLAW_MCP_URL=http://127.0.0.1:9010/mcp
# CDP_CHAT_BROWSERCLAW_PAGE=42
# CDP_CHAT_BROWSERCLAW_MCP_TOKEN=
# CDP_CHAT_BROWSERCLAW_TIMEOUT_MS=600000
